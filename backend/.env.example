# 数据库连接（默认 SQLite 零配置；生产可切 MySQL）
# GRT_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/grt?charset=utf8mb4
# GRT_DATABASE_URL=sqlite:///./grt.db

# 登录 token 签名密钥（留空则自动生成并复用 backend/.secret_key 文件）
# GRT_TOKEN_SECRET=change-me-to-a-long-random-string
# token 有效期（小时）
# GRT_TOKEN_TTL_HOURS=72
